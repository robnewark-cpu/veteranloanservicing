{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veteranloanservicing",
  "main": "workers/site-handler.js",
  "compatibility_date": "2026-07-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
